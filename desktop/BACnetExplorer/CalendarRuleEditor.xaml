<UserControl x:Class="BACnetExplorer.CalendarRuleEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <WrapPanel>
      <StackPanel><TextBlock Text="Rule" /><ComboBox x:Name="RuleKind" SelectedValuePath="Content" SelectedValue="{Binding Kind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100"><ComboBoxItem Content="date" /><ComboBoxItem Content="range" /><ComboBoxItem Content="week" /></ComboBox></StackPanel>
      <StackPanel x:Name="StartField"><TextBlock Text="Date / start (YYYY-MM-DD)" /><TextBox Text="{Binding Start, UpdateSourceTrigger=PropertyChanged}" Width="180" /></StackPanel>
      <StackPanel x:Name="EndField"><TextBlock Text="End (YYYY-MM-DD)" /><TextBox Text="{Binding End, UpdateSourceTrigger=PropertyChanged}" Width="180" /></StackPanel>
      <StackPanel x:Name="MonthField"><TextBlock Text="Month (1–12 / * / odd / even)" /><TextBox Text="{Binding Month, UpdateSourceTrigger=PropertyChanged}" Width="180" /></StackPanel>
      <StackPanel x:Name="WeekField"><TextBlock Text="Week (1–9 / *)" /><TextBox Text="{Binding Week, UpdateSourceTrigger=PropertyChanged}" Width="110" /></StackPanel>
      <StackPanel x:Name="WeekdayField"><TextBlock Text="Weekday (Mon–Sun / *)" /><TextBox Text="{Binding Weekday, UpdateSourceTrigger=PropertyChanged}" Width="155" /></StackPanel>
    </WrapPanel>
    <TextBlock x:Name="RuleHelp" TextWrapping="Wrap" Foreground="#65788F" Margin="0,3,0,5" />
  </StackPanel>
</UserControl>
