<Window x:Class="BACnetExplorer.OperationAlert" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="620" MinWidth="360" SizeToContent="Height" MaxHeight="720"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F1F5FA"
 FontFamily="Segoe UI" Foreground="#20334D" ResizeMode="CanResize">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,14"/>
    <TextBlock x:Name="Summary" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <TextBlock x:Name="Target" FontSize="12" Foreground="#65788F" TextWrapping="Wrap" Margin="0,0,0,14"/>
    <Border Background="White" BorderBrush="#D9E3EF" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,14">
     <StackPanel><TextBlock Text="What to do next" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <TextBlock x:Name="Guidance" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>
    <Expander x:Name="DetailsExpander" Header="Technical details" IsExpanded="False" Margin="0,0,0,10">
     <TextBox x:Name="DetailsText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
      VerticalScrollBarVisibility="Auto" MaxHeight="200" MinHeight="80" Padding="8"
      FontFamily="Consolas" FontSize="12" AutomationProperties.Name="Technical error details"/>
    </Expander>
   </StackPanel>
  </ScrollViewer>
  <DockPanel Grid.Row="1" Margin="0,10,0,0" LastChildFill="False">
   <Button x:Name="CopyButton" Content="Copy details" Click="CopyDetails" Padding="12,6" MinHeight="32"/>
   <Button Content="Close" Click="CloseAlert" IsDefault="True" IsCancel="True" DockPanel.Dock="Right" Padding="18,6" MinHeight="32"/>
  </DockPanel>
 </Grid>
</Window>
