<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Go BACnet Workbench" Manufacturer="Clayton Plymill" Version="0.2.21"
           UpgradeCode="8DB4BF6D-0CED-4BCB-861C-96FD385B38E7" Scope="perUser" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer Go BACnet Workbench version is already installed."/>
    <MediaTemplate EmbedCab="yes"/>
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserPrograms" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Go BACnet Workbench"/>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Go BACnet Workbench"/>
    </StandardDirectory>
    <Component Id="StartMenuShortcut" Directory="ApplicationProgramsFolder" Guid="*">
      <Shortcut Id="WorkbenchShortcut" Name="Go BACnet Workbench" Target="[INSTALLFOLDER]GoBACnetWorkbench.exe"
                WorkingDirectory="INSTALLFOLDER" Icon="WorkbenchIcon.ico" Description="BACnet network troubleshooting and commissioning"/>
      <RemoveFolder Id="RemoveProgramMenu" Directory="ApplicationProgramsFolder" On="uninstall"/>
      <RegistryValue Root="HKCU" Key="Software\Clayton Plymill\Go BACnet Workbench" Name="Installed" Type="integer" Value="1" KeyPath="yes"/>
    </Component>
    <Feature Id="Complete" Title="Go BACnet Workbench" Level="1">
      <ComponentGroupRef Id="Payload"/>
      <ComponentRef Id="StartMenuShortcut"/>
    </Feature>
    <Icon Id="WorkbenchIcon.ico" SourceFile="$(var.AppIcon)"/>
    <Property Id="ARPPRODUCTICON" Value="WorkbenchIcon.ico"/>
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" Sequence="execute"/>
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="Start Go BACnet Workbench from the Windows Start menu. Workspaces and exports are saved where you choose."/>
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)"/>
    <ui:WixUI Id="WixUI_Minimal"/>
  </Package>
</Wix>
